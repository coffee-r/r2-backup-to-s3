# ============================================
# R2 to AWS S3 Backup Configuration
# ============================================

# ==================================================
# Cloudflare R2 Configuration (バックアップ元)
# ==================================================
R2_ENDPOINT=https://xxxxxxxx.r2.cloudflarestorage.com
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET=your-r2-bucket-name

# ==================================================
# AWS S3 Configuration (バックアップ先)
# ==================================================
S3_REGION=ap-northeast-1
S3_ACCESS_KEY=your_aws_access_key
S3_SECRET_KEY=your_aws_secret_key
S3_BUCKET=your_bucket_name

# ==================================================
# Environment Configuration
# ==================================================
# Backup destination prefix: {ENVIRONMENT}/backup-YYYYMMDD_HHMMSS-{ENVIRONMENT}
# Options: local, staging, production
ENVIRONMENT=local

# Run backup on container startup
# Set to "true" for Railway Cron Jobs or automated backups
# Set to "false" for manual execution or debugging
RUN_ON_STARTUP=false

# AWS Storage Class Options:
#   - GLACIER (default) - 復元に3-5時間、最安 ($0.0036/GB/月)
#     最低保存期間90日、早期削除で残り日数分課金
#     復元コスト: Standard $0.01/GB (3-5時間)
#   - STANDARD - 即座にアクセス可能 ($0.023/GB/月)
#     開発/テスト環境での動作確認に推奨
S3_STORAGE_CLASS=GLACIER

# ==================================================
# rclone Configuration (環境変数経由で設定)
# ==================================================
# R2 remote configuration
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACL=private
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true

# S3 remote configuration
RCLONE_CONFIG_S3_TYPE=s3
RCLONE_CONFIG_S3_PROVIDER=AWS
RCLONE_CONFIG_S3_ACL=private
